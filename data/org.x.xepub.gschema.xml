<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.x.xepub" path="/org/x/xepub/">
    <key name="window-width" type="i"><default>1080</default><range min="600" max="32768"/></key>
    <key name="window-height" type="i"><default>760</default><range min="420" max="32768"/></key>
    <key name="window-maximized" type="b"><default>false</default></key>
    <key name="sidebar-page" type="s">
      <choices>
        <choice value="none"/><choice value="contents"/><choice value="bookmarks"/>
        <choice value="annotations"/><choice value="search"/>
      </choices>
      <default>'none'</default>
    </key>
    <key name="search-all-chapters" type="b"><default>true</default></key>
    <key name="search-case-sensitive" type="b"><default>false</default></key>
    <key name="search-whole-words" type="b"><default>false</default></key>
    <key name="search-engines" type="a(sss)">
      <default>[
        ('dictionary', '', 'https://en.wiktionary.org/wiki/Special:Search?search={text}'),
        ('encyclopedia', '', 'https://en.wikipedia.org/wiki/Special:Search?search={text}'),
        ('translate', '', 'https://translate.google.com/?sl=en&amp;tl=de&amp;op=translate&amp;text={text}')
      ]</default>
    </key>
  </schema>
</schemalist>
